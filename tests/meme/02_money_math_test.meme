# 02_money_math_test.meme -- balance math across multiple operations,
# whole-record replacement semantics, and dollar rendering.
use ledger

test balance_math_multiops_test:
    # alice: 0 -> +1000 -> -300 (withdraw) -> -250 (transfer out) = 450
    # bob:   0 -> +250 (transfer in) = 250
    define accounts as empty List<Account>
    add Account(id=1, name="alice", balance_cents=0) to accounts
    add Account(id=2, name="bob", balance_cents=0) to accounts
    set accounts[0] to Account(id=1, name="alice", balance_cents=accounts[0].balance_cents + 1000)
    assert accounts[0].balance_cents == 1000
    set accounts[0] to Account(id=1, name="alice", balance_cents=accounts[0].balance_cents - 300)
    assert accounts[0].balance_cents == 700
    set accounts[0] to Account(id=1, name="alice", balance_cents=accounts[0].balance_cents - 250)
    set accounts[1] to Account(id=2, name="bob", balance_cents=accounts[1].balance_cents + 250)
    assert accounts[0].balance_cents == 450
    assert accounts[1].balance_cents == 250

test exact_balance_withdraw_allowed_test:
    assert check_balance(500, 500) is nothing
    assert check_balance(500, 501) is not nothing

test dollars_text_test:
    assert dollars_text(0) == "0.00"
    assert dollars_text(1) == "0.01"
    assert dollars_text(10) == "0.10"
    assert dollars_text(1050) == "10.50"
    assert dollars_text(123456) == "1234.56"
    assert dollars_text(1000000) == "10000.00"
    assert dollars_text(-250) == "-2.50"

test transaction_ids_allocate_test:
    define txs as empty List<Transaction>
    assert next_transaction_id(txs) == 1
    add Transaction(id=1, from_id=0, to_id=1, amount_cents=100, epoch=1700000000) to txs
    add Transaction(id=5, from_id=1, to_id=0, amount_cents=50, epoch=1700000100) to txs
    assert next_transaction_id(txs) == 6
